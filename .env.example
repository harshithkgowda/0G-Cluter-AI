# OpenRouter API Key for AI Content Generation (Gemini 2.0 Flash)
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Pixabay API Key for Image Search
# Get your key from https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# 0G Network Private Key (optional - for decentralized storage)
# This should be a wallet private key with 0G tokens
ZEROG_PRIVATE_KEY=your_0g_private_key_here

# Site URL (for OpenRouter)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
